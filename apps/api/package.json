{
  "name": "@cards/api",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@cards/contracts": "*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/dictionary/*.test.ts",
    "dictionary:build-seed": "node --env-file-if-exists=../../.env --import tsx scripts/dictionary/build-seed.ts",
    "dictionary:select-topic": "node --env-file-if-exists=../../.env --import tsx scripts/dictionary/select-topic.ts",
    "dictionary:parse-senses": "node --env-file-if-exists=../../.env --import tsx scripts/dictionary/parse-senses.ts",
    "dictionary:validate": "node --env-file-if-exists=../../.env --import tsx scripts/dictionary/validate.ts",
    "dictionary:export-editor": "node --env-file-if-exists=../../.env --import tsx scripts/dictionary/export-editor.ts",
    "dictionary:run": "node --env-file-if-exists=../../.env --import tsx scripts/dictionary/run.ts"
  }
}
